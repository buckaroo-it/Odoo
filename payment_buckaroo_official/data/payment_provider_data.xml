<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <data noupdate="0">

    <record id="payment_provider_buckaroo_official" model="payment.provider">
        <field name="name">Buckaroo Official</field>
        <field name="code">buckaroo_official</field>
        <field name="image_128" type="bytes" file="payment_buckaroo_official/static/description/icon.png"/>
        <field name="sequence">350</field>
        <field name="redirect_form_view_id" ref="payment_buckaroo_official.redirect_form"/>
        <field name="express_checkout_form_view_id"
               ref="payment_buckaroo_official.buckaroo_express_checkout_form"/>
        <field name="allow_express_checkout">True</field>
        <field name="module_id" ref="base.module_payment_buckaroo_official"/>
    </record>

  </data>

  <data noupdate="1">

    <record id="payment_provider_buckaroo_official" model="payment.provider">
        <field name="pending_msg" type="html"><p>Your order has been received and is awaiting payment confirmation.</p></field>
    </record>

  </data>

</odoo>
