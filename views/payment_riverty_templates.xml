<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Riverty: birthdate + salutation inputs inside the payment method
         inline form. Rendered only when the payment method is Riverty.
         Odoo's built-in JS shows/hides o_payment_inline_form when the
         method is selected. Salutation is required for NL/BE shoppers
         per Riverty's API docs. -->
    <template id="riverty_inline_form"
              name="Buckaroo Riverty Inline Form"
              inherit_id="payment.method_form">
        <xpath expr="//div[@name='o_payment_inline_form']" position="inside">
            <t t-if="pm_sudo.code == 'buckaroo_riverty'">
                <t t-set="riverty_partner"
                   t-value="(not request.env.user._is_public()) and request.env.user.partner_id"/>
                <t t-set="riverty_saved_birthdate"
                   t-value="riverty_partner and riverty_partner.buckaroo_riverty_birthdate and riverty_partner.buckaroo_riverty_birthdate.isoformat() or ''"/>
                <t t-set="riverty_saved_salutation"
                   t-value="(riverty_partner and riverty_partner.buckaroo_riverty_salutation) or ''"/>
                <t t-set="riverty_country_code"
                   t-value="(riverty_partner and riverty_partner.country_id and riverty_partner.country_id.code) or ''"/>
                <t t-set="riverty_salutation_required"
                   t-value="riverty_country_code in ('NL', 'BE') or not riverty_country_code"/>
                <!-- B2B detection must key off the order's billing/invoice
                     partner, not the checkout contact (partner_id) — the
                     controller and model gate B2B the same way via
                     order.partner_invoice_id, so the template must agree
                     or a B2B shopper with a different invoice address gets
                     stuck (field hidden, server still requires it). -->
                <t t-set="riverty_invoice_partner"
                   t-value="(sale_order and sale_order.sudo().partner_invoice_id) or (partner_id and request.env['res.partner'].sudo().browse(partner_id).exists()) or request.env['res.partner']"/>
                <t t-set="riverty_is_b2b"
                   t-value="bool(riverty_invoice_partner and (riverty_invoice_partner.is_company or riverty_invoice_partner.commercial_company_name))"/>
                <div class="mt-2">
                    <div class="mb-2">
                        <label class="form-label mb-1"
                               for="o_buckaroo_riverty_salutation">
                            Salutation
                        </label>
                        <select class="form-select o_buckaroo_riverty_salutation"
                                id="o_buckaroo_riverty_salutation"
                                t-att-required="'required' if riverty_salutation_required else None">
                            <option value="" t-att-selected="not riverty_saved_salutation">--</option>
                            <option value="Mr" t-att-selected="riverty_saved_salutation == 'Mr'">Mr</option>
                            <option value="Mrs" t-att-selected="riverty_saved_salutation == 'Mrs'">Mrs</option>
                            <option value="Miss" t-att-selected="riverty_saved_salutation == 'Miss'">Miss</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label mb-1"
                               for="o_buckaroo_riverty_birthdate">
                            Date of birth
                        </label>
                        <input type="date"
                               class="form-control o_buckaroo_riverty_birthdate"
                               id="o_buckaroo_riverty_birthdate"
                               required="required"
                               t-att-value="riverty_saved_birthdate"/>
                    </div>
                    <div class="mb-2" t-if="riverty_is_b2b">
                        <label class="form-label mb-1"
                               for="o_buckaroo_riverty_identification_number">
                            Identification number (Chamber of Commerce / VAT id)
                        </label>
                        <input type="text"
                               class="form-control o_buckaroo_riverty_identification_number"
                               id="o_buckaroo_riverty_identification_number"
                               required="required"
                               t-att-value="riverty_invoice_partner.company_registry or ''"/>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
