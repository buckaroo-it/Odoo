<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_move_form_view_buckaroo_official" model="ir.ui.view">
        <field name="name">account.move.form.view.buckaroo_official</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="valid_for_buckaroo_official_refund" invisible="1"/>
                <button string="Buckaroo Refund"
                    name="action_buckaroo_official_refund" type="object"
                    invisible="not valid_for_buckaroo_official_refund"/>
            </header>
        </field>
    </record>

</odoo>
