<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="applepay_inline_form"
              name="Buckaroo Apple Pay Inline Form"
              inherit_id="payment.method_form">
        <xpath expr="//div[@name='o_payment_inline_form']" position="inside">
            <t t-if="pm_sudo.code == 'buckaroo_applepay'">
                <t t-set="ap_partner"
                   t-value="partner_id and request.env['res.partner'].sudo().browse(partner_id).exists() or request.env['res.partner']"/>
                <t t-set="ap_country"
                   t-value="(ap_partner and ap_partner.country_id) or provider_sudo.company_id.country_id"/>
                <div id="o_buckaroo_applepay_container"
                     class="o_buckaroo_wallet_button d-none"
                     t-att-data-integration-mode="pm_sudo.buckaroo_official_applepay_integration_mode or 'inline'"
                     t-att-data-merchant-guid="pm_sudo.buckaroo_official_applepay_merchant_guid or ''"
                     t-att-data-button-style="pm_sudo.buckaroo_official_applepay_button_style or 'black'"
                     t-att-data-total-amount="amount"
                     t-att-data-currency-code="currency and currency.name or ''"
                     t-att-data-country-code="ap_country and ap_country.code or ''"
                     t-att-data-store-name="provider_sudo.company_id.name or ''"/>
            </t>
        </xpath>
    </template>

    <template id="applepay_express_form"
              name="Buckaroo Apple Pay Express Form">
        <t t-set="ap_method" t-value="provider_sudo.payment_method_ids.filtered(lambda m: m.code == 'buckaroo_applepay' and m.buckaroo_official_applepay_integration_mode == 'inline' and m.buckaroo_official_applepay_show_on_cart and m._buckaroo_applepay_is_configured())[:1]"/>
        <t t-if="ap_method">
            <t t-set="ap_partner"
               t-value="partner_id and request.env['res.partner'].sudo().browse(partner_id).exists() or request.env['res.partner']"/>
            <t t-set="ap_country"
               t-value="(ap_partner and ap_partner.country_id) or provider_sudo.company_id.country_id"/>
            <div name="o_buckaroo_applepay_express_container"
                 t-attf-id="o_buckaroo_applepay_express_container_{{provider_sudo.id}}"
                 class="o_buckaroo_applepay_express_container o_buckaroo_wallet_button w-100 mt-2 d-none"
                 t-att-data-placement="'cart'"
                 t-att-data-provider-id="provider_sudo.id"
                 t-att-data-provider-code="provider_sudo.code"
                 t-att-data-payment-method-id="ap_method.id"
                 t-att-data-merchant-guid="ap_method.buckaroo_official_applepay_merchant_guid"
                 t-att-data-country-code="ap_country and ap_country.code or ''"
                 t-att-data-store-name="provider_sudo.company_id.name or ''"
                 t-att-data-button-style="ap_method.buckaroo_official_applepay_button_style or 'black'"/>
        </t>
    </template>

    <template id="applepay_express_product_page"
              name="Buckaroo Apple Pay Express on Product Page"
              inherit_id="website_sale.cta_wrapper">
        <xpath expr="//div[@id='add_to_cart_wrap']" position="before">
            <t t-set="ap_provider" t-value="request.env['payment.provider'].sudo().search([('code', '=', 'buckaroo_official'), ('state', 'in', ['enabled', 'test']), ('allow_express_checkout', '=', True)], limit=1)"/>
            <t t-set="ap_method" t-value="ap_provider and ap_provider.payment_method_ids.filtered(lambda m: m.code == 'buckaroo_applepay' and m.active and m.buckaroo_official_applepay_integration_mode == 'inline' and m.buckaroo_official_applepay_show_on_product and m._buckaroo_applepay_is_configured())[:1]"/>
            <t t-if="ap_provider and ap_method">
                <t t-set="ap_country"
                   t-value="ap_provider.company_id.country_id"/>
                <t t-set="ap_currency"
                   t-value="website.currency_id or ap_provider.company_id.currency_id"/>
                <div name="o_buckaroo_applepay_express_container"
                     t-attf-id="o_buckaroo_applepay_product_express_{{ap_provider.id}}"
                     class="o_buckaroo_applepay_express_container o_buckaroo_applepay_product_express o_buckaroo_wallet_button w-100 mb-2 d-none"
                     t-att-data-placement="'product'"
                     t-att-data-provider-id="ap_provider.id"
                     t-att-data-provider-code="ap_provider.code"
                     t-att-data-payment-method-id="ap_method.id"
                     t-att-data-merchant-guid="ap_method.buckaroo_official_applepay_merchant_guid or ''"
                     t-att-data-country-code="ap_country and ap_country.code or ''"
                     t-att-data-currency-code="ap_currency and ap_currency.name or ''"
                     t-att-data-store-name="ap_provider.company_id.name or ''"
                     t-att-data-button-style="ap_method.buckaroo_official_applepay_button_style or 'black'"
                     data-landing-route="/shop/payment/validate"/>
            </t>
        </xpath>
    </template>

</odoo>
