<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Billink: T&C checkbox and birthdate inside the payment method inline form.
         Rendered only when the payment method is Billink. Odoo's built-in JS
         shows/hides o_payment_inline_form when the method is selected. -->
    <template id="billink_inline_form"
              name="Buckaroo Billink Inline Form"
              inherit_id="payment.method_form">
        <xpath expr="//div[@name='o_payment_inline_form']" position="inside">
            <t t-if="pm_sudo.code == 'buckaroo_billink'">
                <t t-set="billink_saved_birthdate"
                   t-value="(not request.env.user._is_public()) and request.env.user.partner_id.buckaroo_billink_birthdate and request.env.user.partner_id.buckaroo_billink_birthdate.isoformat() or ''"/>
                <!-- B2B detection must key off the order's billing/invoice
                     partner, not the checkout contact (partner_id) — the
                     controller and model gate B2B the same way via
                     order.partner_invoice_id, so the template must agree
                     or a B2B shopper with a different invoice address gets
                     stuck (field hidden, server still requires it). -->
                <t t-set="billink_invoice_partner"
                   t-value="(sale_order and sale_order.sudo().partner_invoice_id) or (partner_id and request.env['res.partner'].sudo().browse(partner_id).exists()) or request.env['res.partner']"/>
                <t t-set="billink_is_b2b"
                   t-value="bool(billink_invoice_partner and (billink_invoice_partner.is_company or billink_invoice_partner.commercial_company_name))"/>
                <div class="mt-2">
                    <div class="mb-2">
                        <label class="form-label mb-1"
                               for="o_buckaroo_billink_birthdate">
                            Date of birth
                        </label>
                        <input type="date"
                               class="form-control o_buckaroo_billink_birthdate"
                               id="o_buckaroo_billink_birthdate"
                               required="required"
                               t-att-value="billink_saved_birthdate"/>
                    </div>
                    <div class="mb-2" t-if="billink_is_b2b">
                        <label class="form-label mb-1"
                               for="o_buckaroo_billink_chamber_of_commerce">
                            Chamber of Commerce number
                        </label>
                        <input type="text"
                               class="form-control o_buckaroo_billink_chamber_of_commerce"
                               id="o_buckaroo_billink_chamber_of_commerce"
                               required="required"
                               t-att-value="billink_invoice_partner.company_registry or ''"/>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input o_buckaroo_billink_tc"
                               type="checkbox"
                               id="o_buckaroo_billink_tc_checkbox"/>
                        <label class="form-check-label"
                               for="o_buckaroo_billink_tc_checkbox">
                            I agree to the
                            <a href="https://www.billink.nl/algemene-voorwaarden/"
                               target="_blank"
                               rel="noopener noreferrer">
                                Billink Terms and Conditions
                            </a>.
                        </label>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
